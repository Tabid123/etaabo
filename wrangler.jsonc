{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "etaabo",
  "compatibility_date": "2026-10-11",
  "routes": [
    {
      "pattern": "etaabo.com",
      "custom_domain": true
    },
    {
      "pattern": "admin.etaabo.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
